        "\n",
        "# --- 3. DEFINICIÓN EXPLÍCITA DE LA PARTICIÓN TEMPORAL (VALIDACIÓN CRUZADA) ---\n",
        "print(\"\\n--- 2. CONFIGURACIÓN DE PARTICIÓN TEMPORAL ---\")\n",
